#include <zephyr/dt-bindings/clock/stm32u5_clock.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>
/*
 * Arduino UNO Q overlay for sensor_n2k.
 *
 * SPI3 (spi3) is the internal SPI bus to the Linux MPU — already enabled
 * with correct pinctrl in arduino_uno_q-common.dtsi.
 * DMA is added here: without it the 8-byte SPI FIFO causes a header
 * duplication in every slave-mode transfer (first 8 bytes clock out from
 * the FIFO, then the interrupt handler restarts TX from spi_tx[0]).
 *
 * RDY output: PG13 = gpiochip1 line 70 on the Linux side.
 *
 * FDCAN1 RX/TX: PB8 / PB9 (Arduino D9 / D10) — avoids USB OTG FS PHY on PA11/PA12
 * 1-Wire data : PB4 (Arduino D8)
 * ADC ch 9    : PA4 (Arduino A0)
 */

/ {
	chosen {
		zephyr,canbus = &fdcan1;
	};

	/* RDY GPIO — must use DT_PATH(zephyr_user) to match can_spi_bridge_n2k */
	zephyr_user: zephyr,user {
		rdy_gpios = <&gpiog 13 GPIO_ACTIVE_HIGH>;
		/*
		 * Pulse counter inputs (active-high, pull-down).
		 * Connect signal to D3 (PC0) and/or D6 (PC1).
		 * Enable in config: g_sensor_cfg.pulse[n].enabled = true.
		 *   PC0 — D3 / PB0 : STW paddle wheel or tach
		 *   PC1 — D6 / PB1 : engine RPM or second STW
		 */
		//??pc0_gpios = <&gpiob 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		pc0_gpios = <&gpiob 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		pc1_gpios = <&gpiob 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

		/*
		 * Bilge pump monitor inputs — 4-channel PC817 opto-isolator
		 * board, LED side driven from each pump's 12V running line
		 * (through a series resistor), phototransistor side pulling
		 * one of these 3.3V pins. Pump running -> LED lit ->
		 * phototransistor conducts -> pin pulled LOW, so
		 * ACTIVE_LOW+PULL_UP (same convention as pc0_gpios above,
		 * same electrical situation: an external open-collector-ish
		 * output pulling a normally-pulled-up input).
		 *   bilge0 — D2  / PB3
		 *   bilge1 — D7  / PB2
		 *   bilge2 — D11 / PB15
		 *   bilge3 — D12 / PB14
		 * All four confirmed free on this board (not claimed by
		 * 1-Wire/ADC/pulse-counters/FDCAN/USART1/USB OTG pins).
		 */
		bilge0_gpios = <&gpiob 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		bilge1_gpios = <&gpiob 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		bilge2_gpios = <&gpiob 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		bilge3_gpios = <&gpiob 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/*
		 * Alarm buzzer/LED/cancel-button — PLACEHOLDER pins pending real
		 * wiring confirmation (physical bring-up is not part of initial
		 * alarm-feature testing; Bluetooth speaker output is tested
		 * first). GPIOF was the original plan but has no devicetree node
		 * in Zephyr's STM32U5 support at all — see alarm_io.h for the
		 * full explanation. Using GPIOH instead: already enabled below,
		 * PH10-15 are the on-board status LEDs in arduino_uno_q-common.dtsi.
		 * This block is shared with the MCP2515 overlay variant too —
		 * EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt merges onto this same
		 * zephyr_user node rather than replacing it, so no duplicate
		 * block is needed in arduino_uno_q_mcp2515.overlay.
		 *
		 * alarm_button is interrupt-driven, so its pin *number* (not just
		 * port) must not collide with any other interrupt-driven input's
		 * pin number: STM32 EXTI lines are numbered by pin number and
		 * shared across all ports (only one port can own EXTI-line-N's
		 * callback at a time — the second gpio_pin_interrupt_configure()
		 * call for that line silently gets -EBUSY and is never armed,
		 * both call sites here ignore the return value). Pin numbers 0-3
		 * and 14-15 are already claimed by pc0/pc1/bilge0-3 above, so
		 * this must stay off those — PH4 is free. (Originally PH2, which
		 * collided with bilge1_gpios's PB2 and silently broke bilge
		 * channel 1's interrupt — button was never wired up yet so the
		 * conflict went unnoticed until bilge1 testing surfaced it.)
		 */
		alarm_buzzer_gpios = <&gpioh 0 GPIO_ACTIVE_HIGH>;
		alarm_led_gpios    = <&gpioh 1 GPIO_ACTIVE_HIGH>;
		alarm_button_gpios = <&gpioh 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	/*
	 * 1-Wire bus on PB4 (D8). External 4.7 kΩ pull-up to 3.3 V required.
	 * Sensors are enumerated at runtime (up to MAX_OW_SENSORS = 4).
	 * No child device nodes — onewire.c drives the bus via the W1 API directly,
	 * supporting any number of DS18B20s without needing ROM codes in DTS.
	 */
	w1_0: onewire {
		compatible = "zephyr,w1-gpio";
		gpios = <&gpiob 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&gpioh {
	status = "okay";
};

&pinctrl {
    fdcan1_rx_pb8: fdcan1_rx_pb8 {
        pinmux = <STM32_PINMUX('B', 8, AF9)>; /* FDCAN1_RX on PB8 (D9) */
        bias-pull-up;
    };

    fdcan1_tx_pb9: fdcan1_tx_pb9 {
        pinmux = <STM32_PINMUX('B', 9, AF9)>; /* FDCAN1_TX on PB9 (D10) */
        slew-rate = "very-high-speed";
    };
};


/*
 * The board dtsi has SPI2 enabled with NSS on PB9 (same pin as FDCAN1_TX).
 * Disable SPI2 so its pinctrl does not fight for PB9 in the FDCAN build.
 */
&spi2 {
	status = "disabled";
};

/*
 * SPI3 DMA: GPDMA1 request 10 = SPI3_RX, request 11 = SPI3_TX.
 * Use channels 2 (RX) and 3 (TX) — free on this board.
 * Without DMA the 8-byte FIFO causes header duplication on every transfer.
 */
&spi3 {
	dmas = <&gpdma1 2 10 (STM32_DMA_PERIPH_RX | STM32_DMA_MEM_INC | STM32_DMA_MEM_8BITS | STM32_DMA_PERIPH_8BITS)>,
	       <&gpdma1 3 11 (STM32_DMA_PERIPH_TX | STM32_DMA_MEM_INC | STM32_DMA_MEM_8BITS | STM32_DMA_PERIPH_8BITS)>;
	dma-names = "rx", "tx";
};

/*
 * HSE on the Arduino UNO Q is a 16 MHz crystal. Confirmed empirically
 * on hardware via an LSE-referenced (32.768 kHz, independent oscillator)
 * DWT cycle-count measurement: 16,000,082 Hz measured, ~5 ppm off nominal.
 * The board dtsi default of 16 MHz was correct; do not override it.
 */
&clk_hse {
    clock-frequency = <DT_FREQ_M(16)>;
    status = "okay";
};

/* FDCAN1 250 kbit/s classic CAN for NMEA 2000 */
&fdcan1 {
	/* entry 1 = APB1_2 bus gate; entry 2 = KERNEL clock (times the bits).
	 * FDCAN1_SEL(0) = HSE per LL_RCC_FDCAN_CLKSOURCE_HSE. Without this
	 * second entry, can_stm32fd_clock_enable()/get_core_clock() both
	 * skip configuring/reading the real kernel clock and silently
	 * assume the 160 MHz APB1_2 bus clock instead, producing a bit rate
	 * 10x too slow (25 kbit/s instead of 250 kbit/s) since the hardware
	 * is actually clocked from the untouched HSE.
	 */
	clocks = <&rcc STM32_CLOCK(APB1_2, 9)>,
		 <&rcc STM32_SRC_HSE FDCAN1_SEL(0)>;

	pinctrl-0 = <&fdcan1_rx_pb8 &fdcan1_tx_pb9>;
    pinctrl-names = "default";

	/* Exact hardcoded elements forced by the Zephyr stm32 driver build assertions:
     * <offset std-filters ext-filters rx-fifo0 rx-fifo1 rx-buf tx-event-fifo tx-buf> */
    bosch,mram-cfg = <0x0 28 8 3 3 0 3 3>;

    status = "okay";

};

